{
  "name": "@likable-hair/breeze",
  "description": "Job processing for AdonisJS",
  "homepage": "https://github.com/likablehair/breeze#readme",
  "license": "MIT",
  "author": "Filippo Passalacqua <filippo.passalacqua@likablehair.it>",
  "keywords": [
    "adonisjs",
    "jobs",
    "queue",
    "background-jobs",
    "redis",
    "bullmq"
  ],
  "version": "1.1.18",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./jobs_provider": "./build/providers/jobs_provider.js",
    "./commands": "./build/commands/main.js",
    "./commands/*": "./build/commands/*.js",
    "./services/*": "./build/services/*.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint_fix": "eslint . --fix",
    "format": "prettier --write .",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc && npm run index:commands",
    "postbuild": "npm run copy:templates",
    "release": "np",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "index:commands": "adonis-kit index build/commands"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.3.0",
    "@adonisjs/core": "^7.2.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^2.1.0",
    "@japa/runner": "^3.1.1",
    "@poppinss/ts-exec": "^1.1.1",
    "@types/node": "^20.14.2",
    "c8": "^9.1.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^5.1.0",
    "eslint": "^10.1.0",
    "np": "^10.0.5",
    "prettier": "^3.3.1",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.2.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "np": {
    "message": "chore(release): %s",
    "tag": "latest",
    "branch": "master",
    "anyBranch": false
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "dependencies": {
    "@adonisjs/redis": "^10.0.0",
    "@poppinss/utils": "^6.7.3",
    "@queuedash/api": "^2.1.0",
    "@trpc/server": "^10.45.2",
    "bullmq": "^5.41.8",
    "import-meta-resolve": "^4.1.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0"
  }
}
